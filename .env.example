# Copy to .env and fill in before live public-data ingestion.
# Local tests and make reproduce do not require these values.

# data.gov.in free API key (required for live Khelo India pulls)
DATAGOVINDIA_API_KEY=

# AWS (only required for make deploy / make destroy)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional project overrides
IFF_PROJECT_NAME=india-football-funnel
IFF_S3_BUCKET=
IFF_LOCAL_MODE=true
